---
import LocalTimestamp from '#components/LocalTimestamp.astro'
import type { PostFrontmatter } from '#models'
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: PostFrontmatter
}
const { frontmatter } = Astro.props
---

<BaseLayout title={frontmatter.title} ogType="article">
  <article class="post">
    <header>
      <LocalTimestamp date={frontmatter.date} showDate />
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    font-size: var(--font-size-5);

    header {
      margin-bottom: var(--space-size-6);
    }

    p {
      max-width: 70ch;
    }
  }

  .post-content {
    line-height: 1.5;

    img {
      max-width: 100%;
      object-fit: contain;
    }

    a {
      display: inline-block;
      @media (prefers-reduced-motion: no-preference) {
        transition: transform 50ms ease-in-out;
      }

      &:focus,
      &:hover {
        transform: scale(1.05);
      }

      &:active {
        transform: scale(1.02);
      }
    }

    pre[data-language] {
      font-size: var(--font-size-3);
      margin: var(--space-size-5) calc(-1 * var(--space-size-5));
      padding-inline: var(--space-size-5);
    }
  }
</style>
