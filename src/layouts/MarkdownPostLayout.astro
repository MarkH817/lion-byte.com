---
import LD from '#components/LD.astro'
import LocalTimestamp from '#components/LocalTimestamp.astro'
import Conditional from '#components/ui/Conditional.astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: CollectionEntry<'blog' | 'notes'>['data']
}
const { frontmatter } = Astro.props
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
>
  <Fragment slot="additional-meta">
    <meta
      name="article:published_time"
      content={frontmatter.publishedDate.toISOString()}
    />

    <Conditional if={Boolean(frontmatter.modifiedDate)}>
      <meta
        name="article:modified_time"
        content={frontmatter.modifiedDate?.toISOString()}
      />
    </Conditional>

    <LD
      schema={{
        '@type': 'BlogPosting',
        headline: frontmatter.title,
        datePublished: frontmatter.publishedDate.toISOString(),
        dateModified: frontmatter.modifiedDate?.toISOString(),
      }}
    />
  </Fragment>

  <article class="post">
    <header class="post-dates">
      <LocalTimestamp
        class:list="post-date-published"
        date={frontmatter.publishedDate}
        showDate
      />
      <Conditional if={Boolean(frontmatter.modifiedDate)}>
        <LocalTimestamp
          class:list="post-date-modified"
          date={frontmatter.modifiedDate}
          showDate
        />
      </Conditional>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    font-size: var(--font-size-5);

    header {
      margin-bottom: var(--space-size-6);
    }

    p {
      max-width: 70ch;
    }
  }

  .post-dates {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0 var(--space-size-6);
  }

  .post-content {
    line-height: 1.5;

    img {
      max-width: 100%;
      object-fit: contain;
    }

    pre[data-language] {
      font-size: var(--font-size-3);
      margin: var(--space-size-5) calc(-1 * var(--space-size-5));
      padding-inline: var(--space-size-5);
    }
  }
</style>
