---
import LD from '#components/LD.astro'
import LocalTimestamp from '#components/LocalTimestamp.astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'

interface Props {
  frontmatter: CollectionEntry<'blog' | 'notes'>['data']
}
const { frontmatter } = Astro.props
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
>
  <Fragment slot="additional-meta">
    <meta
      name="article:published_time"
      content={frontmatter.date.toISOString()}
    />

    <LD
      schema={{
        '@type': 'BlogPosting',
        headline: frontmatter.title,
        datePublished: frontmatter.date.toISOString(),
      }}
    />
  </Fragment>

  <article class="post">
    <header>
      <LocalTimestamp
        class:list={'post-date'}
        date={frontmatter.date}
        showDate
      />
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    font-size: var(--font-size-5);

    header {
      margin-bottom: var(--space-size-6);
    }

    p {
      max-width: 70ch;
    }
  }

  .post-content {
    line-height: 1.5;

    img {
      max-width: 100%;
      object-fit: contain;
    }

    a {
      display: inline-block;
      @media (prefers-reduced-motion: no-preference) {
        transition: transform 50ms ease-in-out;
      }

      &:focus,
      &:hover {
        transform: scale(1.05);
      }

      &:active {
        transform: scale(1.02);
      }
    }

    pre[data-language] {
      font-size: var(--font-size-3);
      margin: var(--space-size-5) calc(-1 * var(--space-size-5));
      padding-inline: var(--space-size-5);
    }
  }
</style>
