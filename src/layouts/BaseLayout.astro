---
import profileImg from '#assets/profile.png'
import Header from '#components/core/Header.astro'
import LD from '#components/head/LD.astro'
import PreloadFont from '#components/head/PreloadFont.astro'
import AT from '#data/at.json' with { type: 'json' }
import LION from '#data/lion.json' with { type: 'json' }
import SITE from '#data/site.json' with { type: 'json' }
import { AP_SOCIALS, AT_SOCIALS, OTHER_SOCIALS } from '#data/socials.ts'
import '#styles/global.less'
import type { ImageData } from '#types/image.ts'
import nunito400Url from '@fontsource/nunito/files/nunito-latin-400-normal.woff2?url'
import { getImage } from 'astro:assets'

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const rssUrl = new URL('rss.xml', Astro.site)

interface Props {
  title?: string
  displayTitle?: string
  description?: string
  image?: ImageData
  ogType?: 'website' | 'article'
}

const {
  title,
  displayTitle = title,
  description = SITE.description,
  // https://github.com/MarkH817/lion-byte.com/issues/50
  image = { src: profileImg.src, alt: '' },
  ogType = 'website',
} = Astro.props
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name
const cardImage = new URL(image.src, Astro.url.origin)
const favicon = await getImage({
  src: profileImg,
  width: 32,
  height: 32,
  format: 'png',
})
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <title>{pageTitle}</title>

    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />

    <link
      rel="icon"
      type={`image/${favicon.options.format}`}
      href={favicon.src}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en-US" />
    <meta property="og:image" content={cardImage} />
    <meta property="og:image:alt" content={image.alt} />

    <meta property="at:me" content={`at://${AT.did}`} />
    <slot name="at-meta" />

    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:image" content={cardImage} />
    <meta name="twitter:image:alt" content={image.alt} />

    <meta name="pinterest" content="nopin" />

    <slot name="additional-meta" />

    <LD
      schema={{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.name,
        url: SITE.url,
        description: SITE.description,
      }}
    />
    <LD
      schema={{
        '@context': 'https://schema.org',
        '@type': 'Person',
        givenName: LION.firstName,
        familyName: LION.lastName,
        pronouns: LION.pronouns,
        gender: LION.gender,
        sameAs: AT_SOCIALS.concat(AP_SOCIALS, OTHER_SOCIALS).map((s) => s.url),
      }}
    />
    <slot name="additional-ld" />

    <link rel="alternate" type="application/rss+xml" href={rssUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <PreloadFont type="font/woff2" href={nunito400Url} />
    <slot name="additional-preload" />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">
      Skip to main content
    </a>
    <div class="site-container">
      <Header />
      <main id="main-content" class="site-main" tabindex="-1">
        <div class="site-main-header">
          <h1 class="site-main-title">{displayTitle}</h1>
          <div class="site-main-actions">
            <slot name="actions" />
          </div>
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    background-color: var(--background-color);
    left: var(--space-size-3);
    padding: var(--space-size-3) var(--space-size-2);
    position: absolute;
    top: var(--space-size-3);
  }

  .site-container {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: var(--space-size-7) 0;
  }

  .site-main {
    flex-grow: 1;
    margin: 0 auto;
    max-width: 125rem;
    width: 100%;
    outline: none;
    padding: 0 var(--space-size-5);
    @media (max-width: 40rem) {
      padding-inline: var(--space-size-3);
    }
  }

  .site-main-header {
    display: flex;
    flex-direction: row;
    gap: 0 var(--space-size-4);
    flex-wrap: wrap;
    align-items: baseline;
    margin-block-end: var(--space-size-2);
  }

  .site-main-title {
    margin-block: 0;
  }

  .site-main-actions {
    font-size: var(--font-size-4);
    display: flex;
    flex-direction: row;
    flex-direction: wrap;
    gap: 0 var(--space-size-3);
    &:empty {
      display: none;
    }
  }
</style>
