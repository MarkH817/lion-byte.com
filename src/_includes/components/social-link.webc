<a class="social-link" :href="href" target="_blank" rel="me noopener noreferrer">
  <img class="social-link__icon" webc:if="src" :src="src" :alt="label" />
  <span class="social-link__label" webc:if="!src" @text="label"></span>
  <span class="username" @text="username"></span>
</a>

<style>
  .social-link {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    @media (prefers-reduced-motion: no-preference) {
      transition: transform 50ms ease-in-out;
    }

    &:hover,
    &:focus {
      transform: rotate(3deg) scale(1.15);
    }

    &:active {
      transform: rotate(1deg) scale(1.05);
    }
  }

  .social-link__icon {
    width: 1em;
    height: 1em;
    object-fit: contain;
  }

  .social-link__label::after {
    content: ':';
  }
</style>