<article @attributes class="profile-card">
  <div class="profile-card__image-container" webc:if="!reversed">
    <slot name="image"></slot>
  </div>

  <div class="profile-card__content-container">
    <slot></slot>
  </div>

  <div class="profile-card__image-container" webc:if="reversed">
    <slot name="image"></slot>
  </div>
</article>

<style>
  .profile-card {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: var(--space-size-6);
    &[reversed='true'] {
      flex-wrap: wrap-reverse;
    }
  }

  .profile-card__image-container {
    align-items: center;
    display: flex;
    flex: 2 0 8em;
    flex-wrap: wrap;
    justify-content: center;

    img {
      border-radius: 10%;
      height: 16rem;
      width: 16rem;
    }
  }


  .profile-card__content-container {
    flex: 5 1 35em;

    p {
      margin: 0 auto var(--space-size-5);
      max-width: 35em;
      text-align: center;
    }
  }
</style>