---
import PostFeed from '#components/post/PostFeed.astro'
import BaseLayout from '#layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const notes = await getCollection('notes').then((list) =>
  list.toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
)
---

<BaseLayout title="Notes" description="Short notes.">
  <PostFeed basePath="/notes" posts={notes} />
</BaseLayout>
