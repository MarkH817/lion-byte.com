---
import PostFeed from '#components/post/PostFeed.astro'
import BaseLayout from '#layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const blogPosts = await getCollection('blog')
---

<BaseLayout
  title="Blog"
  description="Posts on life events, software development, and anything else I feel like writing about."
>
  <PostFeed basePath="/blog" posts={blogPosts} />
</BaseLayout>
