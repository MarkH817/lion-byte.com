---
import PostFeed from '#components/post/PostFeed.astro'
import BaseLayout from '#layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const blogPosts = await getCollection('blog').then((list) =>
  list.toSorted(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  ),
)
---

<BaseLayout
  title="Blog"
  description="Posts on life events, software development, and anything else I feel like writing about."
>
  <PostFeed basePath="/blog" posts={blogPosts} />
</BaseLayout>
