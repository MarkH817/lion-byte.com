---
import PostFeed from '#components/post/PostFeed.astro'
import AT from '#data/at.json' with { type: 'json' }
import BaseLayout from '#layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const blogPosts = await getCollection('blog')
---

<BaseLayout
  title="Blog"
  description="Posts on life events, software development, and anything else I feel like writing about."
>
  <link
    rel="site.standard.publication"
    href={`at://${AT.did}/site.standard.publication/3mv6qcrmrp5m2`}
    slot="at-meta"
  />
  <PostFeed basePath="/blog" posts={blogPosts} />
</BaseLayout>
