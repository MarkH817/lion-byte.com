---
import photo from '#assets/mark.jpg'
import CareerPosition from '#components/atmosphere/CareerPosition.astro'
import PreloadFont from '#components/head/PreloadFont.astro'
import ProfileCard from '#components/ProfileCard.astro'
import Region from '#components/ui/Region.astro'
import SOCIALS from '#data/socials.json' with { type: 'json' }
import PAGES from '#data/pages.json' with { type: 'json' }
import BaseLayout from '#layouts/BaseLayout.astro'
import nunito200Url from '@fontsource/nunito/files/nunito-latin-200-normal.woff2?url'
import nunito700Url from '@fontsource/nunito/files/nunito-latin-700-normal.woff2?url'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

const positions = await getCollection('careerPositions').then((p) =>
  p.toSorted((a, b) => b.data.startedAt.localeCompare(a.data.startedAt)),
)
---

<BaseLayout
  title={PAGES['/about/'].title}
  description={PAGES['/about/'].description}
>
  <PreloadFont
    type="font/woff2"
    href={nunito200Url}
    slot="additional-preload"
  />
  <PreloadFont
    type="font/woff2"
    href={nunito700Url}
    slot="additional-preload"
  />
  <ProfileCard>
    <Image
      src={photo}
      height={256}
      width={256}
      densities={[1, 1.5]}
      alt="Mark Hernandez"
      priority
      slot="image"
    />

    <p>
      Hello, my name is Mark Hernandez (lion-byte). I use they/them pronouns.
    </p>

    <p>
      I'm a software developer, and I focus on the front-end, accessibility, and
      progressive enhancement. I strive to continuously grow and improve my
      skill-sets to provide a smooth experience for users.
    </p>
  </ProfileCard>

  <Fragment slot="at-meta">
    {positions.map((position) => (
      <meta property="at:alternate" content={position.data.uri} />
    ))}
  </Fragment>

  <Region id="work-history" label="Work History">
    <a href={SOCIALS.sifa.url} target="_blank" rel="me noopener" slot="actions">
      View Sifa Profile
    </a>

    <ul class="list-unstyled position-list">
      {positions.map((position) => (
        <li>
          <CareerPosition {position} />
        </li>
      ))}
    </ul>
  </Region>
</BaseLayout>

<style>
  .position-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-size-8);
  }
</style>
