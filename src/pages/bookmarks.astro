---
import BookmarkList from '#components/atmosphere/BookmarkList.astro'
import PreloadFont from '#components/head/PreloadFont.astro'
import PAGES from '#data/pages.json' with { type: 'json' }
import SOCIALS from '#data/socials.json' with { type: 'json' }
import BaseLayout from '#layouts/BaseLayout.astro'
import nunito700Url from '@fontsource/nunito/files/nunito-latin-700-normal.woff2?url'
---

<BaseLayout
  title={PAGES['/bookmarks/'].title}
  description={PAGES['/bookmarks/'].description}
>
  <PreloadFont
    type="font/woff2"
    href={nunito700Url}
    slot="additional-preload"
  />
  <a href={SOCIALS.margin.url} target="_blank" rel="me noopener" slot="actions">
    View All on Margin
  </a>
  <BookmarkList />
</BaseLayout>

<script>
  const domBookmarks = Array.from(
    document.querySelectorAll<HTMLElement>('.bookmark'),
  )
  const untaggedBookmarks = new Set<HTMLElement>()
  const tagsMap = new Map<string, Set<HTMLElement>>()
  for (const bm of domBookmarks) {
    const tags = bm.dataset.bookmarkTags
      ?.split(',')
      .map((t) => t.trim())
      .filter((t) => t.length > 0)
    if (!tags || tags.length === 0) {
      untaggedBookmarks.add(bm)
      continue
    }

    for (const tag of tags) {
      if (tagsMap.has(tag)) {
        tagsMap.get(tag)?.add(bm)
      } else {
        tagsMap.set(tag, new Set([bm]))
      }
    }
  }
</script>
