---
import Bookmarks from '#components/atmosphere/Bookmarks.astro'
import PreloadFont from '#components/head/PreloadFont.astro'
import PAGES from '#data/pages.json' with { type: 'json' }
import BaseLayout from '#layouts/BaseLayout.astro'
import nunito700Url from '@fontsource/nunito/files/nunito-latin-700-normal.woff2?url'
---

<BaseLayout
  title={PAGES['/bookmarks/'].title}
  description={PAGES['/bookmarks/'].description}
>
  <PreloadFont
    type="font/woff2"
    href={nunito700Url}
    slot="additional-preload"
  />
  <Bookmarks />
</BaseLayout>
