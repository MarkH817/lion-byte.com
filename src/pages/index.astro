---
import profileImg from '#assets/profile.png'
import Bookmarks from '#components/atmosphere/Bookmarks.astro'
import NpmxLikes from '#components/atmosphere/NpmxLikes.astro'
import ProfileCard from '#components/ProfileCard.astro'
import SocialLink from '#components/SocialLink.astro'
import BaseLayout from '#layouts/BaseLayout.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
---

<BaseLayout displayTitle="Welcome">
  <ProfileCard>
    <Image
      src={profileImg}
      height={256}
      width={256}
      densities={[1, 1.5]}
      alt="Mark Hernandez"
      priority
      slot="image"
    />

    <p>
      Personal site and blog of Mark Hernandez. I'm a friend, a gaymer, a
      software developer, and an all-around enjoyer of spaghetti.
    </p>

    <div class="social-links">
      <ul aria-label="Social media links">
        <li>
          <SocialLink
            href="https://kind.social/@lionbyte"
            platform="Mastodon"
            username="lionbyte@kind.social"
          >
            <Icon name="fa7-brands:mastodon" slot="icon" aria-hidden />
          </SocialLink>
        </li>

        <li>
          <SocialLink
            href="https://bsky.app/profile/lion-byte.com"
            platform="Bluesky"
            username="@lion-byte.com"
          >
            <Icon name="fa7-brands:bluesky" slot="icon" aria-hidden />
          </SocialLink>
        </li>

        <li>
          <SocialLink
            href="https://twitch.com/lion_byte"
            platform="Twitch"
            username="lion_byte"
          >
            <Icon name="fa7-brands:twitch" slot="icon" aria-hidden />
          </SocialLink>
        </li>

        <li>
          <SocialLink
            href="https://github.com/MarkH817/"
            platform="GitHub"
            username="MarkH817"
          >
            <Icon name="fa7-brands:github" slot="icon" aria-hidden />
          </SocialLink>
        </li>

        <li>
          <SocialLink
            href="https://www.linkedin.com/in/markhernandez1"
            platform="LinkedIn"
            username="Mark Hernandez"
          >
            <Icon name="fa7-brands:linkedin-in" slot="icon" aria-hidden />
          </SocialLink>
        </li>

        <li>
          <SocialLink
            href="mailto:mark+do.not.spam.me@lion-byte.com"
            platform="Email"
            username="mark@lion-byte.com"
          >
            <Icon name="fa7-solid:envelope" slot="icon" aria-hidden />
          </SocialLink>
        </li>
      </ul>
    </div>
  </ProfileCard>
  <div>
    <NpmxLikes />
    <Bookmarks />
  </div>
</BaseLayout>

<style>
  .social-links ul {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0 0.25rem;
  }

  .so-flexy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-size-7) var(--space-size-10);
    @media (max-width: 40rem) {
      grid-template-columns: 1fr;
    }
  }
</style>
