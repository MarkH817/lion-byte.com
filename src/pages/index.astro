---
import profileImg from '#assets/profile.png'
import Bookmarks from '#components/atmosphere/Bookmarks.astro'
import NpmxLikes from '#components/atmosphere/NpmxLikes.astro'
import ProfileCard from '#components/ProfileCard.astro'
import SocialLink from '#components/SocialLink.astro'
import AT from '#data/at.json' with { type: 'json' }
import SOCIALS from '#data/socials.json' with { type: 'json' }
import BaseLayout from '#layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
---

<BaseLayout displayTitle="Welcome">
  <ProfileCard>
    <Image
      src={profileImg}
      height={256}
      width={256}
      densities={[1, 1.5]}
      alt="Mark Hernandez"
      priority
      slot="image"
    />

    <p>
      Personal site and blog of Mark Hernandez (lion-byte) (they/them). I'm a
      friend, a gaymer, a software developer, and an all-around enjoyer of
      spaghetti.
    </p>

    <div class="social-links">
      <ul aria-label="Social media">
        {
          SOCIALS.map((s) => (
            <li>
              <SocialLink
                href={s.url}
                platform={s.platform}
                username={s.handle}
                icon={s.icon}
              />
            </li>
          ))
        }
        <li>
          <SocialLink
            href="mailto:mark+do.not.spam.me@lion-byte.com"
            platform="Email"
            username="mark@lion-byte.com"
            icon="fa7-solid:envelope"
          />
        </li>
      </ul>
    </div>
  </ProfileCard>

  <div class="social-links">
    <h2>Around the Atmosphere (@lion-byte.com)</h2>
    <ul aria-label="Atmosphere">
      {
        AT.places.map((s) => (
          <li>
            <SocialLink href={s.url} platform={s.platform} icon={s.icon} />
          </li>
        ))
      }
    </ul>
  </div>

  <NpmxLikes />
  <Bookmarks />
</BaseLayout>

<style>
  .social-links ul {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0 0.25rem;
  }
</style>
