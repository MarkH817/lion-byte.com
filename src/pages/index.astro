---
import profileImg from '#assets/profile.png'
import Bookmarks from '#components/atmosphere/Bookmarks.astro'
import NpmxLikes from '#components/atmosphere/NpmxLikes.astro'
import ProfileCard from '#components/ProfileCard.astro'
import SocialLink from '#components/SocialLink.astro'
import BaseLayout from '#layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
---

<BaseLayout displayTitle="Welcome">
  <ProfileCard>
    <Image
      src={profileImg}
      height={256}
      width={256}
      densities={[1, 1.5]}
      alt="Mark Hernandez"
      priority
      slot="image"
    />

    <p>
      Personal site and blog of Mark Hernandez. I'm a friend, a gaymer, a
      software developer, and an all-around enjoyer of spaghetti.
    </p>

    <div class="social-links">
      <ul aria-label="Social media">
        <li>
          <SocialLink
            href="https://kind.social/@lionbyte"
            platform="Mastodon"
            username="lionbyte@kind.social"
            icon="fa7-brands:mastodon"
          />
        </li>
        <li>
          <SocialLink
            href="https://twitch.com/lion_byte"
            platform="Twitch"
            username="lion_byte"
            icon="fa7-brands:twitch"
          />
        </li>
        <li>
          <SocialLink
            href="https://github.com/MarkH817/"
            platform="GitHub"
            username="MarkH817"
            icon="fa7-brands:github"
          />
        </li>
        <li>
          <SocialLink
            href="https://www.linkedin.com/in/markhernandez1"
            platform="LinkedIn"
            username="Mark Hernandez"
            icon="fa7-brands:linkedin"
          />
        </li>
        <li>
          <SocialLink
            href="mailto:mark+do.not.spam.me@lion-byte.com"
            platform="Email"
            username="mark@lion-byte.com"
            icon="fa7-solid:envelope"
          />
        </li>
      </ul>
    </div>
  </ProfileCard>

  <div class="social-links">
    <h2>Around the Atmosphere (@lion-byte.com)</h2>
    <ul aria-label="Atmosphere">
      <li>
        <SocialLink
          href="https://bsky.app/profile/lion-byte.com"
          platform="Bluesky"
          icon="fa7-brands:bluesky"
        />
      </li>
      <li>
        <SocialLink
          href="https://tangled.org/lion-byte.com"
          platform="Tangled"
          icon="fa7-solid:code"
        />
      </li>
      <li>
        <SocialLink
          href="https://sifa.id/p/lion-byte.com"
          platform="Sifa"
          icon="fa7-solid:id-card"
        />
      </li>
      <li>
        <SocialLink
          href="https://margin.at/profile/lion-byte.com"
          platform="Margin"
          icon="fa7-solid:bookmark"
        />
      </li>
      <li>
        <SocialLink
          href="https://semble.so/profile/lion-byte.com"
          platform="Semble"
          icon="fa7-solid:plug"
        />
      </li>
    </ul>
  </div>

  <NpmxLikes />
  <Bookmarks />
</BaseLayout>

<style>
  .social-links ul {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0 0.25rem;
  }
</style>
