---
import LocalTimestamp from '#components/LocalTimestamp.astro'
import Conditional from '#components/ui/Conditional.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  basePath: '/blog' | '/notes'
  posts: CollectionEntry<'blog' | 'notes'>[]
}

const { basePath, posts } = Astro.props
---

<ol class="feed-list list-unstyled">
  {
    posts.map((post) => (
      <li>
        <a class="h3 title" href={`${basePath}/${post.id}/`}>
          {post.data.title}
        </a>
        <div>
          <LocalTimestamp date={post.data.publishedDate} showDate />
        </div>
        <Conditional if={post.data.description.length > 0}>
          <p class="description">{post.data.description}</p>
        </Conditional>
      </li>
    ))
  }
</ol>

<style>
  .feed-list {
    li {
      margin: var(--space-size-6) 0;
    }
  }

  .title {
    text-wrap: balance;
    display: inline-block;
  }

  .description {
    max-width: 70ch;
  }
</style>
