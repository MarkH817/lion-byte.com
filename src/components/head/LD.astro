---
import type {
  BlogPosting,
  Graph,
  Person,
  WebSite,
  WithContext,
} from 'schema-dts'

interface Props {
  schema: WithContext<BlogPosting | Person | WebSite> | Graph
}
const { schema } = Astro.props
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
></script>
