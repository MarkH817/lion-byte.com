---
import navigation from '#data/navigation.json' with { type: 'json' }
---

<header class="header">
  <a class="header-name" href="/">Mark Hernandez</a>

  <nav class="nav" aria-label="Main">
    <ul class="nav-list list-unstyled">
      {
        navigation.main.map((item) => (
          <li>
            <a
              href={item.url}
              aria-current={item.url === Astro.url.pathname ? 'page' : null}
              data-state={
                item.url.length > 1 && Astro.url.pathname.startsWith(item.url)
                  ? 'active'
                  : null
              }
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-wrap: wrap;
    font-family: var(--font-nunito);
    font-size: var(--font-size-6);
    padding: var(--space-size-3);
    gap: var(--space-size-3);
    @media (max-width: 60rem) {
      align-items: center;
    }
    @media print {
      display: none;
    }
  }

  .header-name,
  .nav-list a {
    &:not(:hover):not(:focus) {
      text-decoration: none;
    }
  }

  .header-name {
    padding: var(--space-size-1) var(--space-size-3);
    display: block;
    text-align: center;
  }

  .nav-list {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-size-4);
  }
  .nav-list a {
    display: block;
    border-bottom: 0.125rem solid transparent;
    padding: var(--space-size-1) var(--space-size-3);

    &:hover,
    &:focus {
      border-bottom-style: dashed;
    }

    &[aria-current],
    &[data-state='active'] {
      border-color: currentColor;
      text-decoration: none;
    }
  }
</style>
