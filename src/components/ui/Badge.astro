---
import { Icon } from 'astro-icon/components'
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag
  icon: string
}>
const { as: Tag = 'div', icon, class: className, ...attrs } = Astro.props
---

<Tag class="badge" class:list={[className]} {...attrs}>
  <Icon class="badge-icon" name={icon} aria-hidden="true" />
  <slot />
</Tag>

<style>
  .badge {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-size-1);
  }

  .badge-icon {
    flex-shrink: 0;
  }
</style>
