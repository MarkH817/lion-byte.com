---
import { Icon } from 'astro-icon/components'
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag
  icon: string
}>
const { as: Tag = 'div', icon, class: className, ...attrs } = Astro.props
---

<Tag class="badge" class:list={[className]} {...attrs}>
  <div class="badge-icon">
    <Icon name={icon} aria-hidden="true" />
  </div>
  <div class="badge-content">
    <slot />
  </div>
</Tag>

<style>
  .badge {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    line-height: 1;
    gap: var(--space-size-1);
    text-box-edge: cap alphabetic;
  }

  .badge-icon,
  .badge-content {
    flex-shrink: 0;
  }

  .badge-icon {
    height: 1em;
  }

  .badge-content {
    flex-grow: 1;
    text-box-trim: trim-both;
  }
</style>
