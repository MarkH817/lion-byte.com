---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  label: string
}
const { id = `region-${crypto.randomUUID()}`, label } = Astro.props
---

<section class="region" aria-labelledby={id}>
  <header class="region-header">
    <h2 {id} class="region-heading">
      {label}
    </h2>
    <div class="region-actions">
      <slot name="actions" />
    </div>
  </header>
  <slot />
</section>

<style>
  .region-header {
    display: flex;
    flex-direction: row;
    gap: 0 var(--space-size-4);
    flex-wrap: wrap;
    align-items: baseline;
  }

  .region-actions {
    font-size: var(--font-size-4);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0 var(--font-size-3);
    &:empty {
      display: none;
    }
  }
</style>
