---
import { formatDate } from '#utils/date.ts'

interface Props {
  date?: Date
  showDate?: boolean
  showTime?: boolean
  class?: string | string[]
}
const {
  date = new Date(),
  showDate = true,
  showTime = false,
  class: className,
} = Astro.props
const staticFallback = formatDate(date, {
  language: 'en-US',
  showDate,
  showTime,
})
---

<time
  data-local-ts
  data-local-ts-date={showDate ? true : undefined}
  data-local-ts-time={showTime ? true : undefined}
  datetime={date.toISOString()}
  class="timestamp"
  class:list={className}>{staticFallback}</time
>

<script>
  import { formatDate } from '#utils/date.ts'

  function localizeTimestamps() {
    const timestamps =
      document.querySelectorAll<HTMLTimeElement>('[data-local-ts]')
    timestamps.forEach((t) => {
      const isoString = t.getAttribute('datetime')
      if (!isoString) {
        return
      }
      try {
        const localDate = new Date(isoString)
        t.textContent = `${formatDate(localDate, {
          language: navigator.language,
          showDate: t.hasAttribute('data-local-ts-date'),
          showTime: t.hasAttribute('data-local-ts-time'),
        })}`
      } catch (e) {
        console.error('Failed to parse timestamp:', e)
      }
    })
  }
  localizeTimestamps()
</script>
