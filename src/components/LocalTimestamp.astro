---
interface Props {
  date?: Date
  showDate?: boolean
  showTime?: boolean
}
const {
  date: date = new Date(),
  showDate = true,
  showTime = false,
} = Astro.props
const staticFallback = new Intl.DateTimeFormat('en-US', {
  dateStyle: showDate ? 'long' : undefined,
  timeStyle: showTime ? 'short' : undefined,
}).format(date)
---

<time
  data-local-ts
  data-local-ts-date={showDate ? true : undefined}
  data-local-ts-time={showTime ? true : undefined}
  datetime={date.toISOString()}
  class='timestamp'>{staticFallback}</time
>

<script>
  function localizeTimestamps() {
    const timestamps =
      document.querySelectorAll<HTMLTimeElement>('[data-local-ts]')

    timestamps.forEach((t) => {
      const formatter = new Intl.DateTimeFormat(navigator.language, {
        dateStyle: t.hasAttribute('data-local-ts-date') ? 'long' : undefined,
        timeStyle: t.hasAttribute('data-local-ts-time') ? 'short' : undefined,
      })
      const isoString = t.getAttribute('datetime')
      if (!isoString) {
        return
      }
      try {
        const localDate = new Date(isoString)
        t.textContent = `${formatter.format(localDate)}`
      } catch (e) {
        console.error('Failed to parse timestamp:', e)
      }
    })
  }
  localizeTimestamps()
</script>
