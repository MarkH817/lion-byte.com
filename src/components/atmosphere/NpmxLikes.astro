---
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

const id = `npm-likes-${crypto.randomUUID()}`
const likes = await getCollection('npmxLikes').then((l) =>
  l.toSorted((a, b) => a.data.packageName.localeCompare(b.data.packageName)),
)
---

<section aria-labelledby={id}>
  <h2 {id}>{likes.length} Liked Packages (via npmx.dev)</h2>

  <ul class="list-unstyled package-list">
    {
      likes.map((like) => (
        <li>
          <a
            class="package"
            href={like.data.subjectRef}
            target="_blank"
            rel="noopener"
          >
            <Icon
              name="fa7-solid:box-open"
              class:list="package-icon"
              aria-hidden
            />
            <span>{like.data.packageName}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .package-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-size-3) var(--space-size-5);
  }

  .package {
    display: inline-flex;
    gap: var(--space-size-2);
    font-size: var(--font-size-4);
    align-items: center;
    line-height: 1;
    padding: var(--space-size-2) var(--space-size-4);
    border-radius: var(--space-size-2);
    border: 1px dotted currentColor;
  }

  .package-icon {
    flex-shrink: 0;
  }
</style>
