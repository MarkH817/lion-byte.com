---
import Badge from '#components/ui/Badge.astro'
import { getCollection } from 'astro:content'

const likes = await getCollection('npmxLikes').then((l) => l.toReversed())
---

<ul class="list-unstyled package-list">
  {likes.map((like) => (
    <li>
      <Badge
        as="a"
        class="package"
        href={like.data.subjectRef}
        target="_blank"
        rel="noopener"
        icon="fa7-solid:box-open"
      >
        {like.data.packageName}
      </Badge>
    </li>
  ))}
</ul>

<style>
  .package-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-size-3) var(--space-size-5);
    li {
      content-visibility: auto;
      contain-intrinsic-size: auto 10rem auto 3rem;
    }
  }

  .package {
    font-size: var(--font-size-4);
    line-height: 1;
    gap: var(--space-size-2);
    border-radius: var(--space-size-2);
    padding: var(--space-size-2) var(--space-size-4);
    border: 1px dotted currentColor;
    &:focus-visible {
      outline-offset: -0.15rem;
      border-color: transparent;
    }
  }
</style>
