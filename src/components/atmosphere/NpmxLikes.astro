---
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

const likes = await getCollection('npmxLikes').then((l) => l.toReversed())
---

<ul class="list-unstyled package-list">
  {
    likes.map((like) => (
      <li>
        <a
          class="package"
          href={like.data.subjectRef}
          target="_blank"
          rel="noopener"
        >
          <Icon
            name="fa7-solid:box-open"
            class:list="package-icon"
            aria-hidden
          />
          <span>{like.data.packageName}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .package-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-size-3) var(--space-size-5);
    li {
      content-visibility: auto;
      contain-intrinsic-size: auto 10rem auto 3rem;
    }
  }

  .package {
    display: inline-flex;
    gap: var(--space-size-2);
    font-size: var(--font-size-4);
    align-items: center;
    line-height: 1;
    padding: var(--space-size-2) var(--space-size-4);
    border-radius: var(--space-size-2);
    border: 1px dotted currentColor;
    &:focus-visible {
      border-color: transparent;
    }
  }

  .package-icon {
    flex-shrink: 0;
  }
</style>
