---
import Conditional from '#components/ui/Conditional.astro'
import type { CollectionEntry } from 'astro:content'
import sanitizeHtml from 'sanitize-html'
import { markdownToHtml } from 'satteri'

interface Props {
  position: CollectionEntry<'careerPositions'>
}
const { position } = Astro.props

function monthToText(month: string): string {
  switch (month) {
    case '01':
      return 'Jan'
    case '02':
      return 'Feb'
    case '03':
      return 'Mar'
    case '04':
      return 'Apr'
    case '05':
      return 'May'
    case '06':
      return 'Jun'
    case '07':
      return 'Jul'
    case '08':
      return 'Aug'
    case '09':
      return 'Sep'
    case '10':
      return 'Oct'
    case '11':
      return 'Nov'
    case '12':
      return 'Dec'
    default:
      return month
  }
}

/**
 * Sifa ID dates are only stored as `YYYY-MM`,
 * so I gotta format it myself.
 */
function formatPositionDate(yearMonth?: string): string {
  if (!yearMonth) {
    return 'n/a'
  }

  try {
    const [year, month] = yearMonth.split('-')
    return `${monthToText(month)} ${year}`
  } catch (e) {
    console.error(e)
    return yearMonth
  }
}
---

<article id={position.id} class="position">
  <header class="position-main-info">
    <h3 class="position-title">{position.data.title}</h3>

    <Conditional if={Boolean(position.data.company)}>
      <span class="position-company">{position.data.company}</span>
    </Conditional>

    <div class="position-dates">
      <time>{formatPositionDate(position.data.startedAt)}</time>{' '}
      &mdash;{' '}
      <Conditional if={Boolean(position.data.endedAt)}>
        <time>{formatPositionDate(position.data.endedAt)}</time>
        <span slot="else">Current</span>
      </Conditional>
    </div>
  </header>

  {
    position.data.description && (
      <div
        class="position-description"
        set:html={sanitizeHtml(markdownToHtml(position.data.description).html)}
      />
    )
  }
</article>

<style>
  .position {
    display: grid;
    gap: var(--space-size-4);
    grid-template-columns: 20rem 70ch;
    @media (max-width: 75rem) {
      grid-template-columns: minmax(min-content, 70ch);
    }
  }

  .position-main-info {
    display: flex;
    flex-direction: column;
  }

  .position-title {
    line-height: 1;
    margin: 0;
    font-weight: bold;
  }

  .position-company {
    font-weight: 200;
    font-size: var(--font-size-4);
  }

  .position-dates {
    font-size: var(--font-size-2);
    font-weight: bold;
  }

  .position-description {
    font-size: var(--font-size-4);
  }

  :global(.position-description) {
    p {
      margin: 0 0 var(--space-size-1) 0;
    }
    ul {
      margin: 0 0 var(--space-size-5) 0;
    }

    :last-child {
      margin-bottom: 0;
    }
  }
</style>
