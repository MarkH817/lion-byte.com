---
import type { HTMLAttributes } from 'astro/types'
import { getCollection } from 'astro:content'
import Bookmark from './Bookmark.astro'

interface Props extends HTMLAttributes<'ul'> {
  limit?: number
}
const { class: className, limit, ...attrs } = Astro.props
const bookmarks = await getCollection('marginAtNotes').then((l) =>
  l.toReversed(),
)
---

<ul class="list-unstyled bookmark-list" class:list={[className]} {...attrs}>
  {bookmarks.slice(0, limit).map((bookmark) => (
    <li>
      <Bookmark {bookmark} />
    </li>
  ))}
</ul>

<style>
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-size-6) var(--space-size-8);
  }

  .bookmark-list li {
    &:nth-child(n + 11) {
      content-visibility: auto;
      contain-intrinsic-size: auto 4rem;
    }
    &:has(:global(.bookmark[hidden])) {
      display: none;
    }
  }
</style>
