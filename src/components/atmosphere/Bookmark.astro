---
import Badge from '#components/ui/Badge.astro'
import Conditional from '#components/ui/Conditional.astro'
import { unique, type GroupByResult } from '#utils/list.ts'
import { pick } from '#utils/object.ts'
import { Icon } from 'astro-icon/components'
import type { HTMLAttributes } from 'astro/types'
import type { CollectionEntry } from 'astro:content'

interface Props extends HTMLAttributes<'article'> {
  entry: GroupByResult<string, CollectionEntry<'marginAtNotes'>>
}
const { class: className, entry, ...attrs } = Astro.props
const common = pick(entry.items[0].data, ['title', 'source'])
const hostname = new URL(common.source).hostname
const tags = unique(entry.items.flatMap((item) => item.data.tags))
const id = `bookmark-${crypto.randomUUID()}`
---

<article
  class="bookmark"
  class:list={[className]}
  data-bookmark-title={common.title}
  data-bookmark-hostname={hostname}
  aria-labelledby={id}
  {...attrs}
>
  <header>
    <a
      {id}
      class="h3 title"
      href={common.source}
      target="_blank"
      rel="noopener"
    >
      {common.title}{' '}
      <span class="arrow" aria-hidden="true">
        &nearrow;
      </span>
    </a>

    <div class="info">
      <div class="hostname">
        <span class="visually-hidden">Hostname:</span>
        {hostname}
      </div>
      <ul
        class="list-unstyled tags"
        class:list={{ 'tags--empty': tags.length === 0 }}
        aria-label="Tags"
      >
        {tags.length > 0 ? (
          tags.map((tag) => (
            <li>
              <Badge icon="fa7-solid:tag">{tag}</Badge>
            </li>
          ))
        ) : (
          <li>untagged</li>
        )}
      </ul>
    </div>
  </header>

  <Conditional if={entry.items.some((i) => i.data.highlightQuote)}>
    <div class="annotations-and-highlights">
      {entry.items.map((item) =>
        item.data.highlightQuote ? (
          <blockquote cite={item.data.source}>
            <Icon name="fa7-solid:highlighter" aria-hidden />
            {item.data.highlightQuote}
          </blockquote>
        ) : null,
      )}
    </div>
  </Conditional>
</article>

<style>
  .bookmark {
    display: flex;
    flex-direction: column;
    gap: var(--space-size-3);
  }

  .title {
    margin: 0;
    margin-block-end: var(--space-size-1);
    text-wrap: balance;
    display: inline-block;
  }

  .arrow {
    font-size: var(--font-size-2);
  }

  .info {
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-size-1) var(--space-size-6);
    justify-content: space-between;
    font-weight: bold;
  }

  .hostname {
    font-size: var(--font-size-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-size-5);
    font-size: var(--font-size-1);
    &.tags--empty {
      font-style: italic;
    }
  }

  .annotations-and-highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min-content, 50ch));
    gap: var(--space-size-2);
    align-items: start;
  }

  blockquote {
    font-style: italic;
    line-height: 1.25;
    font-size: var(--font-size-3);
    border-radius: var(--space-size-3);
    border-inline-start: 2px solid var(--color-main);
    margin: 0;
    padding-inline: var(--space-size-5);
    padding-block: var(--space-size-3);
    white-space: pre-wrap;
  }
</style>
