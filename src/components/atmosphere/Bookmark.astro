---
import Badge from '#components/ui/Badge.astro'
import Conditional from '#components/ui/Conditional.astro'
import { Icon } from 'astro-icon/components'
import type { HTMLAttributes } from 'astro/types'
import type { CollectionEntry } from 'astro:content'

interface Props extends HTMLAttributes<'article'> {
  bookmark: CollectionEntry<'marginAtNotes'>
}
const { class: className, bookmark, ...attrs } = Astro.props
const { title, source, tags, quotes, annotations } = bookmark.data
const hostname = new URL(source).hostname
const id = `bookmark-${bookmark.id}`
---

<article
  class="bookmark"
  class:list={[className]}
  data-bookmark-title={title}
  data-bookmark-hostname={hostname}
  data-bookmark-tags={tags.join(',')}
  aria-labelledby={id}
  {...attrs}
>
  <header>
    <a {id} class="h3 title" href={source} target="_blank" rel="noopener">
      {title}{' '}
      <span class="arrow" aria-hidden="true">
        &nearrow;
      </span>
    </a>

    <div class="info">
      <div class="hostname">
        <span class="visually-hidden">Hostname:</span>
        {hostname}
      </div>
      <ul
        class="list-unstyled tags"
        class:list={{ 'tags--empty': tags.length === 0 }}
        aria-label="Tags"
      >
        {tags.length > 0 ? (
          tags.map((tag) => (
            <li>
              <Badge icon="fa7-solid:tag">{tag}</Badge>
            </li>
          ))
        ) : (
          <li>untagged</li>
        )}
      </ul>
    </div>
  </header>

  <Conditional if={annotations.length > 0}>
    <div class="annotation-list">
      {annotations.map((annotation) => (
        <p class="annotation">
          <Icon name="fa7-solid:paw" aria-hidden="true" />
          {annotation}
        </p>
      ))}
    </div>
  </Conditional>

  <Conditional if={quotes.length > 0}>
    <div class="highlight-list">
      {quotes.map((quote) => (
        <blockquote class="highlight" cite={source}>
          <Icon name="fa7-solid:highlighter" aria-hidden="true" />
          {quote}
        </blockquote>
      ))}
    </div>
  </Conditional>
</article>

<style>
  .bookmark {
    display: flex;
    flex-direction: column;
    gap: var(--space-size-3);
  }

  .title {
    margin: 0;
    margin-block-end: var(--space-size-1);
    text-wrap: balance;
    display: inline-block;
  }

  .arrow {
    font-size: var(--font-size-2);
  }

  .info {
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-size-1) var(--space-size-6);
    justify-content: space-between;
    font-weight: bold;
  }

  .hostname {
    font-size: var(--font-size-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-size-5);
    font-size: var(--font-size-1);
    &.tags--empty {
      font-style: italic;
    }
  }

  .highlight-list,
  .annotation-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min-content, 50ch));
    gap: var(--space-size-2);
    align-items: start;
  }

  .highlight {
    font-style: italic;
    line-height: 1.25;
    font-size: var(--font-size-3);
    border-radius: var(--space-size-3);
    border-inline-start: 2px solid var(--color-main);
    margin: 0;
    padding-inline: var(--space-size-5);
    padding-block: var(--space-size-3);
    white-space: pre-wrap;
  }

  .annotation {
    margin: 0;
  }
</style>
