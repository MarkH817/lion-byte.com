---
import { groupBy } from '#utils/list.ts'
import { getCollection } from 'astro:content'
import Bookmark from './Bookmark.astro'

interface Props {
  limit?: number
}
const { limit } = Astro.props
const bookmarks = await getCollection('marginAtNotes').then((l) =>
  l.toReversed(),
)
const groupedBookmarks = groupBy(bookmarks, (b) => b.data.source)
---

<ul class="list-unstyled bookmark-list">
  {
    groupedBookmarks.slice(0, limit).map((group) => (
      <li>
        <Bookmark entry={group} />
      </li>
    ))
  }
</ul>

<style>
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-size-6) var(--space-size-8);
  }
</style>
