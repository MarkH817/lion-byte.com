---
import Badge from '#components/ui/Badge.astro'
import { groupBy, unique } from '#utils/list.ts'
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

const bookmarks = await getCollection('marginAtNotes').then((l) =>
  l.toReversed(),
)
const groupedBookmarks = groupBy(bookmarks, (b) => b.data.source)

function getGroupInfo(group: typeof bookmarks) {
  const item = group[0].data
  return { title: item.title, source: item.source }
}
function getGroupTags(group: typeof bookmarks) {
  return unique(group.flatMap((item) => item.data.tags))
}
---

<h2>Bookmarks (via margin.at)</h2>

{
  groupedBookmarks.map((group) => {
    const common = getGroupInfo(group.items)
    const tags = getGroupTags(group.items)
    return (
      <article class="bookmark">
        <header>
          <h3 class="title">
            <a href={common.source} target="_blank" rel="noopener noreferrer">
              {common.title}{' '}
              <span style="font-size: smaller;" aria-hidden="true">
                &nearrow;
              </span>
            </a>
          </h3>
          <div class="info">
            <div class="hostname">{new URL(common.source).hostname}</div>
            <div class="tags" class:list={{ 'tags--empty': tags.length === 0 }}>
              {tags.length > 0 ? (
                tags.map((tag) => <Badge label={tag} icon="fa7-solid:tag" />)
              ) : (
                <Badge label="untagged" />
              )}
            </div>
          </div>
        </header>
        {group.items.map((item) =>
          item.data.highlightQuote ? (
            <blockquote cite={item.data.source}>
              <Icon name="fa7-solid:highlighter" aria-hidden />
              {item.data.highlightQuote}
            </blockquote>
          ) : null,
        )}
      </article>
    )
  })
}

<style>
  .bookmark {
    margin-block-end: var(--space-size-6);
  }

  .title {
    margin: 0;
    margin-block-end: var(--space-size-1);
    text-wrap: balance;
  }

  .info {
    line-height: 1;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-size-1) var(--space-size-6);
    justify-content: space-between;
    @media (max-width: 40rem) {
      flex-direction: column;
    }
  }

  .hostname {
    font-size: var(--font-size-2);
    font-weight: bold;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-size-5);
    &.tags--empty {
      font-style: italic;
    }
  }

  blockquote {
    font-style: italic;
    line-height: 1.25;
    max-width: 60ch;
    font-size: var(--font-size-3);
    border-radius: var(--space-size-3);
    border-inline-start: 2px solid var(--color-main);
    margin: 0;
    margin-block-start: var(--space-size-3);
    padding-inline: var(--space-size-5);
    padding-block: var(--space-size-3);
    white-space: pre-wrap;
    & + & {
      margin-block-start: var(--space-size-2);
    }
  }
</style>
