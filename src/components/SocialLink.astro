---
import Badge from './ui/Badge.astro'

interface Props {
  href: string
  platform: string
  icon: string
  username?: string
}

const { icon, href, platform, username } = Astro.props
---

<Badge
  as="a"
  class="social-link"
  href={href}
  target="_blank"
  rel="me noopener"
  aria-label={username ? `${username} on ${platform}` : platform}
  {icon}
>
  {username ?? platform}
</Badge>

<style>
  .social-link {
    flex-wrap: nowrap;
    font-size: var(--font-size-5);
    gap: var(--space-size-1);
    padding: var(--space-size-3) var(--space-size-4);
  }
</style>
