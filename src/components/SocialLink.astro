---
import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  platform: string
  icon: string
  username?: string
}

const { icon, href, platform, username } = Astro.props
---

<a
  class="social-link"
  href={href}
  target="_blank"
  rel="me noopener noreferrer"
  aria-label={username ? `${platform}: ${username}` : platform}
>
  <Icon name={icon} class:list="icon" aria-hidden />
  <span>
    {username ?? platform}
  </span>
</a>

<style>
  .social-link {
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-size-1);
    padding: var(--space-size-3) var(--space-size-4);
    @media (prefers-reduced-motion: no-preference) {
      transition: transform 50ms ease-in-out;
      &:hover,
      &:focus {
        transform: rotate(3deg) scale(1.15);
      }

      &:active {
        transform: rotate(1deg) scale(1.05);
      }
    }
  }

  .icon {
    flex-shrink: 0;
  }
</style>
