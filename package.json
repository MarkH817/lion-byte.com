{
  "name": "lion-byte.com",
  "private": true,
  "version": "2.0.0",
  "description": "Mark Hernandez's portfolio site",
  "author": "Mark Hernandez <mark@lion-byte.com> (https://www.lion-byte.com)",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "run-s -l format:*",
    "format:prettier": "prettier --ignore-path .gitignore --write \"**/*.+(js|mjs|ts|json|yml|yaml|astro|css|md)\"",
    "lex:build": "lex build",
    "test": "run-p -l test:*",
    "test:type": "astro check",
    "test:unit": "vitest run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/MarkH817/lion-byte.com.git"
  },
  "keywords": [
    "blog",
    "personal site"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=12.0.1"
  },
  "type": "module",
  "license": "MIT",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#data/*": "./src/_data/*",
    "#layouts/*": "./src/layouts/*",
    "#lexicons/*": "./src/lexicons/*",
    "#loaders/*": "./src/loaders/*",
    "#types/*": "./src/types/*",
    "#schemas/*": "./src/schemas/*",
    "#scripts/*": "./src/scripts/*",
    "#styles/*": "./src/styles/*",
    "#utils/*": "./src/utils/*"
  },
  "devDependencies": {
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@atproto/lex": "^0.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.5",
    "astro-og": "^0.3.2",
    "astrojs-atom": "^4.0.16",
    "modern-normalize": "^3.0.1",
    "node-html-parser": "^7.1.0",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "core-js": false,
    "fsevents": false
  }
}
