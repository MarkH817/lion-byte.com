{
  "name": "lion-byte.com",
  "version": "2.0.0",
  "description": "Mark Hernandez's portfolio site",
  "author": "Mark Hernandez <mark@lion-byte.com> (https://www.lion-byte.com)",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "format": "npm run prettier",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.+(json|yml|yaml|astro|css|md)\"",
    "test": "npm run type && node --test",
    "type": "astro check"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/MarkH817/lion-byte.com.git"
  },
  "keywords": [
    "blog",
    "personal site"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "license": "MIT",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#data/*": "./src/_data/*",
    "#layouts/*": "./src/layouts/*",
    "#models": "./src/models/index.ts",
    "#models/*": "./src/models/*",
    "#scripts/*": "./src/scripts/*",
    "#styles/*": "./src/styles/*"
  },
  "devDependencies": {
    "@iconify-json/fa7-brands": "^1.2.2",
    "@iconify-json/fa7-solid": "^1.2.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.1",
    "@types/sanitize-html": "^2.16.1",
    "date-fns": "^4.4.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.4.8",
    "astro-icon": "^1.1.5",
    "astrojs-atom": "^3.0.63",
    "markdown-it": "^14.2.0",
    "modern-normalize": "^3.0.1",
    "node-html-parser": "^7.1.0",
    "sanitize-html": "^2.17.5",
    "typeface-nunito": "1.1.13",
    "typeface-open-sans": "1.1.13"
  }
}
